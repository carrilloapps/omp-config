{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "palette": {
    "ubuntu_orange": "#E95420",
    "canonical_red": "#C7162B",
    "ubuntu_green": "#0E8420",
    "aubergine": "#77216F",
    "aubergine_mid": "#5E2750",
    "aubergine_dark": "#2C001E",
    "warm_white": "#F7F7F7",
    "warm_gray": "#C7C2BC",
    "warm_dim": "#928B85",
    "cool_dark": "#333333",
    "yellow": "#F3A229",
    "red": "#C7162B",
    "blue": "#335280",
    "highlight": "#FFFFFF",
    "aubergine_light": "#C25EAD"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:ubuntu_green",
          "template": " {{ .Full }} ",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:blue",
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "options": {
            "fetch_version": true,
            "display_mode": "files",
            "display_virtual_env": true
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:blue",
          "template": " {{ .Full }} ",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:canonical_red",
          "template": " {{ .Full }} ",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "p:aubergine_mid",
          "template": " {{ .Full }} ",
          "options": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "p:aubergine",
          "template": "{{ if .Context }}☸ {{ .Context }}{{ if .Namespace }}  {{ .Namespace }}{{ end }} {{ end }}"
        },
        {
          "type": "aws",
          "style": "plain",
          "foreground": "p:ubuntu_orange",
          "template": "{{ if .Profile }} {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} {{ end }}"
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ if and .Context (ne .Context \"default\") (ne .Context \"desktop-linux\") }} {{ .Context }} {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:warm_gray",
          "template": " {{ if .Env.POSH_RAM }}{{ .Env.POSH_RAM }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:ubuntu_orange",
          "template": " {{ if .Env.POSH_CPU }}{{ .Env.POSH_CPU }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:aubergine_light",
          "template": "{{ if .Env.POSH_GPU }} {{ .Env.POSH_GPU }} {{ end }}"
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "p:warm_gray",
          "foreground_templates": [
            "{{ if le .Percentage 20 }}p:canonical_red{{ end }}",
            "{{ if and (gt .Percentage 20) (le .Percentage 50) }}p:yellow{{ end }}",
            "{{ if eq \"Charging\" .State.String }}p:ubuntu_orange{{ end }}"
          ],
          "template": "{{ if eq \"Charging\" .State.String }} {{ end }}{{ if ge .Percentage 90 }}{{ else if ge .Percentage 60 }}{{ else if ge .Percentage 30 }}{{ else if ge .Percentage 10 }}{{ else }}{{ end }} {{ .Percentage }}%{{ if ne \"Discharging\" .State.String }} {{ end }} "
        },
        {
          "type": "connection",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if and (ne .OS \"windows\") .State (eq .State \"disconnected\") }} OFFLINE {{ end }}"
        },
        {
          "type": "upgrade",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "{{ if .Latest }}↑ OMP {{ .Latest }} {{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:aubergine_dark",
          "foreground": "p:ubuntu_orange",
          "template": "{{ if .Env.POSH_SPOTIFY }} ♫ {{ .Env.POSH_SPOTIFY }} {{ end }}"
        },
        {
          "type": "ipify",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:aubergine_dark",
          "foreground": "p:ubuntu_orange",
          "template": "{{ if not .Env.POSH_SPOTIFY }}  {{ .IP }} {{ end }}",
          "options": {
            "cache_duration": "1h",
            "http_timeout": 1000
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:ubuntu_orange",
          "template": "{{ .Icon }} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:highlight",
          "template": "{{ lower .UserName }}@{{ lower .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:warm_gray",
          "template": "{{ .Path }} ",
          "options": {
            "folder_icon": "....",
            "home_icon": "~",
            "style": "agnoster_short"
          }
        },
        {
          "type": "project",
          "style": "plain",
          "foreground": "p:aubergine_mid",
          "template": "{{ if .Name }}{{ .Name }}{{ if .Version }} v{{ .Version }}{{ end }} {{ end }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:ubuntu_orange",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:canonical_red{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }} ",
          "options": {
            "branch_icon": " ",
            "commit_icon": " ",
            "tag_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "{{ if gt .Jobs 0 }} {{ .Jobs }} {{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:ubuntu_green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:canonical_red{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ else }} {{ end }}",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:warm_dim",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:warm_dim",
          "template": " {{ .CurrentDate | date \"15:04:05\" }} ",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:ubuntu_orange",
          "template": "❯ "
        }
      ]
    }
  ]
}